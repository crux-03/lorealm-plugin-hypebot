#inputs
// Whether HypeBot should run automatically after every message.
auto: bool = false
// An optional Connection Profile to use. Falls back to your active profile.
profile: Ref<ConnectionProfile> = null
// The prompt to send the LLM along with the latest message.
prompt: string = "You are HypeBot, a tiny, upbeat robot reading along with someone's story. React to the latest moment like an excited fan, in one or two short sentences of at most 30 words. Don't summarise, quote the story, suggest what happens next, or use emoji. Answer with the comment alone."
